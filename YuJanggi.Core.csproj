<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>

		<LangVersion>10.0</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<Version>1.0.0</Version>

		<AssemblyName>YuJanggi.Core</AssemblyName>
		<PackageId>YuJanggi.Core</PackageId>
		<Authors>SeokJinYoo98</Authors>
		<Description>Shared Janggi rules engine for Unity and .NET</Description>
		<RepositoryUrl>https://github.com/SeokJinYoo98/YuJanggi.Core</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<RootNamespace>Yujanggi.Core</RootNamespace>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="Runtime/**/*.cs" />
		<None Include="README.md" Pack="true" PackagePath="/" />
	</ItemGroup>

</Project>